// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductSize {
  S
  M
  L
  XL
  XXL
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]
  cartItems CartItem[]
  reviews   Review[]
  wishlist  Wishlist[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  imageUrl    String?
  isTopCollection Boolean  @default(false)
  topCollectionOrder Int   @default(0)
  isNewArrival Boolean      @default(false)
  newArrivalOrder Int       @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  sizeStocks  ProductSizeStock[]
  sizeMeasurements ProductSizeMeasurement[]
  images      ProductImage[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reviews     Review[]
  wishlist    Wishlist[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProductSizeStock {
  id        String      @id @default(cuid())
  productId String
  color     String      @default("Default")
  size      ProductSize
  quantity  Int         @default(0)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, size])
}

model ProductSizeMeasurement {
  id        String      @id @default(cuid())
  productId String
  size      ProductSize
  height    Decimal?    @db.Decimal(6, 2)
  width     Decimal?    @db.Decimal(6, 2)
  waist     Decimal?    @db.Decimal(6, 2)
  hip       Decimal?    @db.Decimal(6, 2)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  color     String
  view      String
  url       String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, view])
  @@index([productId, color])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  customerName String?
  customerEmail String?
  phone     String?
  address   String?
  city      String?
  postcode  String?
  country   String?
  paymentMethod String @default("COD")
  trackingCode String? @unique
  inventoryDecremented Boolean @default(false)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  color     String   @default("Default")
  size      ProductSize @default(M)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  verifiedPurchase Boolean @default(false)
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model InventoryAdjustment {
  id           String   @id @default(cuid())
  productId    String
  color        String   @default("Default")
  size         ProductSize @default(M)
  quantityChange Int
  quantityAfter Int
  reason       String
  actorEmail   String?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}
